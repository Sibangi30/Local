import java.util.Scanner;

public class Code71 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

       
        System.out.print("Enter first string: ");
        String str1 = sc.nextLine();

        System.out.print("Enter second string: ");
        String str2 = sc.nextLine();

        System.out.print("Enter a character to search: ");
        char ch = sc.next().charAt(0);

      
        StringBuilder changedCase = new StringBuilder();
        for (int i = 0; i < str1.length(); i++) {
            char c = str1.charAt(i);
            if (Character.isUpperCase(c))
                changedCase.append(Character.toLowerCase(c));
            else
                changedCase.append(Character.toUpperCase(c));
        }
        System.out.println("\nCase Changed: " + changedCase);

      
        String reversed = new StringBuilder(str1).reverse().toString();
        System.out.println("Reversed String: " + reversed);

        
        if (str1.equals(str2))
            System.out.println("Strings are equal.");
        else
            System.out.println("Strings are not equal.");

        
        String inserted = str1 + str2;
        System.out.println("Inserted String: " + inserted);

        
        System.out.println("Upper Case: " + str1.toUpperCase());
        System.out.println("Lower Case: " + str1.toLowerCase());

        
        int pos = str1.indexOf(ch);
        if (pos != -1)
            System.out.println("Character '" + ch + "' found at position: " + pos);
        else
            System.out.println("Character '" + ch + "' not found.");

        
        if (str1.equalsIgnoreCase(reversed))
            System.out.println("String is a palindrome.");
        else
            System.out.println("String is not a palindrome.");

        
        int wordCount = 0, vowelCount = 0, consonantCount = 0;
        boolean inWord = false;

        for (int i = 0; i < str1.length(); i++) {
            char c = Character.toLowerCase(str1.charAt(i));

            
            if (Character.isWhitespace(c)) {
                inWord = false;
            } else {
                if (!inWord) {
                    wordCount++;
                    inWord = true;
                }
            }

            
            if (Character.isLetter(c)) {
                if ("aeiou".indexOf(c) != -1)
                    vowelCount++;
                else
                    consonantCount++;
            }
        }

        System.out.println("Word Count: " + wordCount);
        System.out.println("Vowel Count: " + vowelCount);
        System.out.println("Consonant Count: " + consonantCount);
    }
}
